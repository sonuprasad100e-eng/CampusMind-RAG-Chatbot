{
  "name": "campusmind",
  "version": "1.0.0",
  "description": "CampusMind — RAG-Based College Information Chatbot",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "seed:admin": "cd server && npm run seed:admin",
    "seed:docs": "cd server && npm run seed:docs",
    "test:rag": "cd server && npm run test:rag",
    "build:client": "cd client && npm run build",
    "start:server": "cd server && npm start",
    "start:client": "cd client && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "rag",
    "chatbot",
    "college",
    "vector-search",
    "embeddings",
    "nextjs",
    "express",
    "mongodb"
  ],
  "author": "CampusMind Team",
  "license": "ISC",
  "dependencies": {
    "groq-sdk": "^1.6.0",
    "openai": "^7.9.0"
  }
}
