GROQ_API_KEY=

# Vector Search Thresholds
RAG_SIMILARITY_THRESHOLD=0.72
RAG_TOP_K=5

# Redis (Optional for BullMQ - automatic synchronous queue fallback enabled if omitted)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Uploads directory
UPLOAD_DIR=uploads


